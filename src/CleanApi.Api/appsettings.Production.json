{
  // Production. ASPNETCORE_ENVIRONMENT defaults to Production when it is not set.
  // No Swagger, no automatic migrations, less verbose logging.
  // Supply the connection string from the host (environment variable, Key Vault, ...), never commit it:
  //   ConnectionStrings__Database="Server=<prod-sql-server>;Database=CleanApi;User Id=<user>;Password=<password>;Encrypt=True"
  "OpenApi": {
    "Enabled": false
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
