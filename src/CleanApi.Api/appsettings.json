{
  // Shared defaults for every environment. appsettings.{Environment}.json overrides these values,
  // and environment variables override both (e.g. ConnectionStrings__Database).
  "ConnectionStrings": {
    "Database": ""
  },
  "OpenApi": {
    "Enabled": false
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
