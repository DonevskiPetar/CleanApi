{
  // Shared defaults for every environment. appsettings.{Environment}.json overrides these values,
  // and environment variables override both (e.g. ConnectionStrings__Database).
  // Redis is optional: leave it empty to use an in-memory cache per instance.
  // Set ConnectionStrings__Redis (e.g. "my-redis:6380,password=...,ssl=True,abortConnect=False") to share the cache.
  "ConnectionStrings": {
    "Database": "",
    "Redis": ""
  },
  "Caching": {
    "DefaultExpiration": "00:05:00",
    "LocalExpiration": "00:01:00",
    "InstanceName": "CleanApi:"
  },
  "OpenApi": {
    "Enabled": false
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
