{
  // Local development: LocalDB, Swagger on, database migrated automatically, SQL statements logged.
  "ConnectionStrings": {
    "Database": "Server=(localdb)\\MSSQLLocalDB;Database=CleanApi;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "OpenApi": {
    "Enabled": true
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  }
}
