{
  // Test (QA) environment. Run with ASPNETCORE_ENVIRONMENT=Test.
  // Supply the connection string from the host, never commit it:
  //   ConnectionStrings__Database="Server=<test-sql-server>;Database=CleanApi_Test;User Id=<user>;Password=<password>;Encrypt=True"
  "OpenApi": {
    "Enabled": true
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
