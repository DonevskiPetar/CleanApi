{
  // Acceptance (UAT / staging) environment. Run with ASPNETCORE_ENVIRONMENT=Acceptance.
  // Mirrors Production as closely as possible; Swagger stays on so testers can explore the API.
  // Migrations are applied by the deployment pipeline, not on startup.
  // Supply the connection string from the host, never commit it:
  //   ConnectionStrings__Database="Server=<acc-sql-server>;Database=CleanApi_Acc;User Id=<user>;Password=<password>;Encrypt=True"
  "OpenApi": {
    "Enabled": true
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
