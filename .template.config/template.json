{
  "$schema": "http://json.schemastore.org/template",
  "author": "Petar Donevski",
  "classifications": [ "Web", "WebAPI", "Clean Architecture" ],
  "identity": "CleanApi.WebApi.Template",
  "name": "Clean Architecture Web API",
  "description": "ASP.NET Core Web API with Domain / Application / Infrastructure / Api layers, CQRS handlers, Mapperly, FluentValidation, EF Core and unit tests.",
  "shortName": "cleanapi",
  "sourceName": "CleanApi",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            ".vs/**",
            ".git/**",
            "**/bin/**",
            "**/obj/**",
            "**/*.user",
            "**/*.db",
            "**/*.db-shm",
            "**/*.db-wal",
            "**/TestResults/**"
          ]
        }
      ]
    }
  ]
}
